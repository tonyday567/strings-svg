cabal-version: 3.0
name: strings-svg
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE
copyright: Tony Day (c) 2026
category: graphics
author: Tony Day
maintainer: tonyday567@gmail.com
homepage: https://github.com/tonyday567/strings-svg#readme
bug-reports: https://github.com/tonyday567/strings-svg/issues
synopsis: String-diagram SVG rendering for circuits-int via chart-svg
description:
  Layout and chart-svg rendering for the compact-closed string-diagram
  DSL in @circuits-int@ ('Circuit.Int.StringDiagram').  Produces dark
  house-palette equality diagrams (yanking, sliding, braid, interchange,
  star/Arden).

build-type: Simple
tested-with:
  ghc ==9.14.1

extra-doc-files:
  ChangeLog.md
  readme.md

source-repository head
  type: git
  location: https://github.com/tonyday567/strings-svg

common ghc-options-stanza
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

common ghc-options-exe-stanza
  ghc-options:
    -fforce-recomp
    -funbox-strict-fields
    -rtsopts
    -threaded
    -with-rtsopts=-N

common ghc2024-additions
  default-extensions:
    DataKinds
    DerivingStrategies
    DisambiguateRecordFields
    ExplicitNamespaces
    GADTs
    LambdaCase
    MonoLocalBinds
    RoleAnnotations

common ghc2024-stanza
  if impl(ghc >=9.10)
    default-language:
      GHC2024
  else
    import: ghc2024-additions
    default-language:
      GHC2021

library
  import: ghc-options-stanza
  import: ghc2024-stanza
  hs-source-dirs: src
  exposed-modules:
    Strings.Svg
    Strings.Svg.Examples
    Strings.Svg.Layout
    Strings.Svg.Palette
    Strings.Svg.Render
  build-depends:
    base >=4.18 && <5,
    bytestring >=0.11 && <0.13,
    chart-svg >=0.8 && <0.9,
    circuits-int >=0.1 && <0.2,
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.6,
    optics-core >=0.4 && <0.5,
    text >=1.2 && <2.2,

executable render-examples
  import: ghc-options-exe-stanza
  import: ghc-options-stanza
  import: ghc2024-stanza
  main-is: render-examples.hs
  hs-source-dirs: app
  build-depends:
    base >=4.18 && <5,
    filepath >=1.4 && <1.6,
    strings-svg,

test-suite spec
  import: ghc-options-stanza
  import: ghc2024-stanza
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  build-depends:
    base >=4.18 && <5,
    chart-svg >=0.8 && <0.9,
    circuits-int >=0.1 && <0.2,
    strings-svg,
